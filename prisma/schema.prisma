// ============================================================================
// 17. TABELA: CheckinHidratacao (Módulo de Aderência Hídrica)
// ============================================================================
model CheckinHidratacao {
  id           String   @id @default(uuid())
  pacienteId   String
  volumeMl     Int      // Volume ingerido no registro (ex: 500ml)
  metaDiariaMl Int      @default(2500) // Meta configurada pelo médico
  data         DateTime @default(now())

  @@map("checkins_hidratacao")
}

// ============================================================================
// 18. TABELA: ProntuarioPaciente (Ficha Clínica Digital do Paciente)
// ============================================================================
model ProntuarioPaciente {
  id           String    @id @default(uuid()) @db.Uuid
  pacienteId   String    @unique @map("paciente_id") @db.Uuid
  pesoAtualKg  Decimal?  @map("peso_atual_kg") @db.Decimal(5, 2)
  alturaCm     Decimal?  @map("altura_cm") @db.Decimal(5, 2)
  imc          Decimal?  @db.Decimal(4, 2)
  objetivo     String?   @db.Text
  comorbidades String?   @db.Text
  alergias     String?   @db.Text
  medicacoes   String?   @db.Text
  evolucao     String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient      Patient   @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@map("prontuarios_pacientes")
}

// ============================================================================
// 19. TABELA: EvolucaoClinica (Histórico de Consultas e Linha do Tempo)
// ============================================================================
model EvolucaoClinica {
  id                String   @id @default(uuid()) @db.Uuid
  pacienteId        String   @map("paciente_id") @db.Uuid
  dataAtendimento   DateTime @default(now()) @map("data_atendimento") @db.Timestamptz(6)
  pesoAtual         Float?   @map("peso_atual")
  alturaCm          Float?   @map("altura_cm")
  imc               Float?
  queixaPrincipal   String?  @map("queixa_principal") @db.Text
  condutaEvolucao   String   @map("conduta_evolucao") @db.Text
  medicoResponsavel String   @default("Dr. Carlos Fantini") @map("medico_responsavel") @db.VarChar(160)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient           Patient  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId, dataAtendimento(sort: Desc)])
  @@map("evolucoes_clinicas")
}

// ============================================================================
// 20. TABELA: RegistroGlicemia (Monitoramento Bidirecional de Glicemia Capilar)
// ============================================================================
model RegistroGlicemia {
  id           String   @id @default(uuid()) @db.Uuid
  pacienteId   String   @map("paciente_id") @db.Uuid
  dataRegistro DateTime @default(now()) @map("data_registro") @db.Timestamptz(6)
  valor        Int      // mg/dL
  momento      String   @default("JEJUM") @db.VarChar(30) // 'JEJUM', 'POS_PRANDIAL', 'CASUAL'
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  paciente     Patient  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId, dataRegistro(sort: Desc)])
  @@index([dataRegistro(sort: Desc)])
  @@map("registros_glicemia")
}

// ============================================================================
// 21. TABELA: Medico (Corpo Clínico / Profissionais da Agenda da Clínica FAAZ)
// ============================================================================
model Medico {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @db.VarChar(160)
  especialidade String?  @db.VarChar(120)
  corHex        String   @default("#059669") @map("cor_hex") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  agendamentos  Agendamento[]

  @@map("medicos")
}

// ============================================================================
// 22. TABELA: Agendamento (Agenda Diária de Consultas e Exames da Clínica FAAZ)
// ============================================================================
model Agendamento {
  id             String   @id @default(uuid()) @db.Uuid
  pacienteId     String   @map("paciente_id") @db.Uuid
  medicoId       String   @default("00000000-0000-4000-8000-000000000001") @map("medico_id") @db.Uuid
  especialidade  String   @default("ENDOCRINOLOGIA") @db.VarChar(40) // 'ENDOCRINOLOGIA', 'CIRURGIA_PLASTICA'
  dataHora       DateTime @map("data_hora") @db.Timestamptz(6)
  duracaoMinutos Int      @default(30) @map("duracao_minutos")
  encaixe        Boolean  @default(false)
  tipo           String   @default("RETORNO") @db.VarChar(40) // 'PRIMEIRA_CONSULTA', 'RETORNO', 'EXAME'
  status         String   @default("AGENDADO") @db.VarChar(30) // 'AGENDADO', 'CONFIRMADO', 'CANCELADO', 'FINALIZADO'
  observacao     String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  paciente   Patient  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  medico     Medico   @relation(fields: [medicoId], references: [id], onDelete: Restrict)

  @@index([dataHora(sort: Asc)])
  @@index([especialidade, dataHora(sort: Asc)])
  @@index([medicoId, dataHora(sort: Asc)])
  @@index([pacienteId, dataHora(sort: Desc)])
  @@map("agendamentos")
}

// ============================================================================
// ============================================================================
// 23. TABELA: Alimento (Banco de Alimentos e Nutrientes Base - TACO / UNICAMP)
// ============================================================================
model Alimento {
  id            String         @id @default(uuid()) @db.Uuid
  nome          String         @unique @db.VarChar(255)
  porcaoBase    Float          @default(100) @map("porcao_base") // ex: 100g
  calorias      Float          // kcal na porção base
  proteinas     Float          // gramas
  carboidratos  Float          // gramas
  gorduras      Float          // gramas
  fibras        Float?         @default(0) // gramas
  categoria     String?        @default("Geral") @db.VarChar(100)
  fonte         String?        @default("TACO") @db.VarChar(50)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  itensRefeicao ItemRefeicao[]
  substituicoes DietSubstitution[]

  @@index([nome])
  @@index([categoria])
  @@map("alimentos")
}

// ============================================================================
// 24. TABELA: PlanoAlimentar (Prescrição Dietética Vinculada ao Paciente)
// ============================================================================
model PlanoAlimentar {
  id          String          @id @default(uuid()) @db.Uuid
  pacienteId  String          @map("paciente_id") @db.Uuid
  titulo      String          @default("Plano Alimentar") @db.VarChar(160)
  objetivo    String?         @db.VarChar(255)
  ativo       Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  paciente    Patient         @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  variacoes   VariacaoDieta[]

  @@index([pacienteId])
  @@map("planos_alimentares")
}

// ============================================================================
// 24.1 TABELA: VariacaoDieta (Opções de Cardápio: Opção 1, Opção 2, Treino...)
// ============================================================================
model VariacaoDieta {
  id               String         @id @default(uuid()) @db.Uuid
  planoAlimentarId String         @map("plano_alimentar_id") @db.Uuid
  nome             String         @db.VarChar(100) // 'Opção 1 (Padrão)', 'Opção 2 (Variada)', 'Dia de Treino', 'Fim de Semana'
  descricao        String?        @db.VarChar(255)
  ordem            Int            @default(1)
  ativo            Boolean        @default(true)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  planoAlimentar   PlanoAlimentar @relation(fields: [planoAlimentarId], references: [id], onDelete: Cascade)
  refeicoes        Refeicao[]

  @@index([planoAlimentarId, ordem])
  @@map("variacoes_dieta")
}

// ============================================================================
// 25. TABELA: Refeicao (Refeições vinculadas à Variação: Desjejum, Almoço...)
// ============================================================================
model Refeicao {
  id              String         @id @default(uuid()) @db.Uuid
  variacaoDietaId String         @map("variacao_dieta_id") @db.Uuid
  nome            String         @db.VarChar(100) // 'Café da Manhã', 'Lanche da Manhã', 'Almoço', 'Lanche da Tarde', 'Jantar', 'Ceia'
  horario         String?        @db.VarChar(10)  // '07:30', '12:30', etc.
  ordem           Int            @default(1)
  observacoes     String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  variacaoDieta   VariacaoDieta  @relation(fields: [variacaoDietaId], references: [id], onDelete: Cascade)
  itens           ItemRefeicao[]

  @@index([variacaoDietaId, ordem])
  @@map("refeicoes")
}

// ============================================================================
// 26. TABELA: ItemRefeicao (Vínculo de Refeição ao Alimento com Quantidade em Gramas)
// ============================================================================
model ItemRefeicao {
  id               String    @id @default(uuid()) @db.Uuid
  refeicaoId       String    @map("refeicao_id") @db.Uuid
  alimentoId       String    @map("alimento_id") @db.Uuid
  quantidadeGramas Float     @default(100) @map("quantidade_gramas")
  observacao       String?   @db.VarChar(160)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  refeicao         Refeicao  @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)
  alimento         Alimento  @relation(fields: [alimentoId], references: [id], onDelete: Restrict)
  substituicoes    DietSubstitution[]

  @@index([refeicaoId])
  @@index([alimentoId])
  @@map("itens_refeicoes")
}

// ============================================================================
// 27. TABELA: CheckInSono (Módulo Sono & Recuperação do Paciente via App)
// ============================================================================
model CheckInSono {
  id         String   @id @default(uuid()) @db.Uuid
  pacienteId String   @map("paciente_id") @db.Uuid
  horas      Float
  qualidade  String   @default("BOM") @db.VarChar(50)
  observacao String?  @db.Text
  data       DateTime @default(now()) @db.Timestamptz(6)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  paciente   Patient  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId, data(sort: Desc)])
  @@map("checkins_sono")
}

// ============================================================================
// 28. TABELA: WorkoutLog (Habit Tracker de Treinos / Atividade Física)
// ============================================================================
model WorkoutLog {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  date       DateTime @default(now()) @db.Timestamptz(6)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, date(sort: Desc)])
  @@map("workout_logs")
}

// ============================================================================
// 29. TABELA: DietSubstitution (Substituições / Trocas de Alimentos pelo Paciente)
// ============================================================================
model DietSubstitution {
  id                   String        @id @default(uuid()) @db.Uuid
  patientId            String        @map("patient_id") @db.Uuid
  prescribedDietItemId String        @map("prescribed_diet_item_id") @db.Uuid
  substituteFoodId     String?       @map("substitute_food_id") @db.Uuid
  substituteFoodName   String        @map("substitute_food_name") @db.VarChar(160)
  quantityGrams        Float         @default(100) @map("quantity_grams")
  calories             Float         @default(0)
  proteins             Float?        @default(0)
  carbohydrates        Float?        @default(0)
  fats                 Float?        @default(0)
  date                 DateTime      @default(now()) @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient              Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribedDietItem   ItemRefeicao  @relation(fields: [prescribedDietItemId], references: [id], onDelete: Cascade)
  substituteFood       Alimento?     @relation(fields: [substituteFoodId], references: [id], onDelete: SetNull)

  @@index([patientId, date(sort: Desc)])
  @@index([prescribedDietItemId])
  @@map("diet_substitutions")
}

// ============================================================================
// 30. TABELA: Measurement (Antropometria, Circunferências e Composição Corporal)
// ============================================================================
model Measurement {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @map("patient_id") @db.Uuid
  measuredAt        DateTime @default(now()) @map("measured_at") @db.Timestamptz(6)
  bodyFatPercentage Float?   @map("body_fat_percentage")
  waist             Float?
  abdomen           Float?
  hips              Float?
  rightArm          Float?   @map("right_arm")
  leftArm           Float?   @map("left_arm")
  rightThigh        Float?   @map("right_thigh")
  leftThigh         Float?   @map("left_thigh")
  notes             String?  @db.VarChar(255)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, measuredAt(sort: Desc)])
  @@map("measurements")
}

// ============================================================================
// 31. TABELA: DocumentTemplate (Modelos Clínicos Salvos - Receitas/Exames/Atestados)
// ============================================================================
model DocumentTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  title          String   @db.VarChar(160)
  content        String   @db.Text
  category       String   @db.VarChar(40)
  documentTitle  String?  @map("document_title") @db.VarChar(200)
  organizationId String?  @map("organization_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category, createdAt(sort: Asc)])
  @@map("document_templates")
}







